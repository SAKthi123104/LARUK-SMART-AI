{% extends "base.html" %}

{% block content %}
<!-- Premium Header -->
<div class="fade-in-down mb-8">
  <div class="text-center">
    <div class="inline-block mb-4">
      <div class="text-7xl font-black gradient-text animate-pulse">
        LARUK
      </div>
    </div>
    <p class="text-xl text-gray-300 font-light tracking-wide mb-2">
      Next-Generation AI Companion
    </p>
    <p class="text-gray-400 text-sm">
      Powered by Advanced AI • Real-Time Responses
    </p>
  </div>

  <!-- Authentication Section -->
  <div class="mt-8 flex flex-col items-center gap-4">
    <div class="flex gap-3 flex-wrap justify-center">
      <button class="google-login px-6 py-3 rounded-lg text-white font-semibold focus:outline-none" onclick="handleGoogleLogin()">
        <i class="fab fa-google mr-2"></i>
        Sign in with Google
      </button>
      <button class="btn-premium px-6 py-3 rounded-lg text-white font-semibold focus:outline-none" onclick="handleGuestLogin()">
        <i class="fas fa-arrow-right mr-2"></i>
        Continue as Guest
      </button>
    </div>
    <p class="text-gray-500 text-xs mt-2">No account needed • Instant access</p>
  </div>
</div>

<!-- Premium Chat Container -->
<div class="chat-premium p-6 flex flex-col h-[600px] slide-in-up">
  <!-- Chat Display -->
  <div id="chat-box" class="flex-1 overflow-y-auto mb-6 space-y-4 scroll-smooth pr-2">
    <!-- Initial Message -->
    <div class="message msg-ai text-white p-5 rounded-xl max-w-2xl">
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center text-lg">
            🔥
          </div>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-indigo-300 mb-2">LARUK AI</p>
          <p class="text-gray-200 text-sm leading-relaxed">
            Welcome! I'm LARUK, powered by advanced AI technology. Ask me anything - I can help with coding, explain complex concepts, answer questions, and have intelligent conversations. I'm here 24/7! 🚀
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Input Area -->
  <div class="border-t border-gray-700 pt-6">
    <form id="chat-form" class="flex gap-3">
      <div class="flex-1">
        <textarea 
          id="message-input"
          name="message" 
          placeholder="Ask me anything... Press Enter to send, Shift+Enter for new line"
          rows="2"
          class="w-full p-4 rounded-lg bg-gray-800 text-white placeholder-gray-500 border border-gray-700 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 resize-none focus:outline-none transition-all"
          autocomplete="off"
        ></textarea>
      </div>
      <button 
        type="submit" 
        class="btn-premium px-6 py-4 rounded-lg text-white font-bold hover:shadow-lg focus:outline-none flex items-center justify-center gap-2 h-fit self-end"
        title="Send message (Ctrl+Enter)"
      >
        <i class="fas fa-sparkles"></i>
        <span>Ask</span>
      </button>
    </form>
  </div>
</div>

<!-- Footer -->
<div class="mt-8 text-center">
  <div class="flex justify-center items-center gap-3 text-gray-400 text-sm">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 bg-green-500 rounded-full pulse"></span>
      <span>AI Online</span>
    </div>
    <span class="text-gray-600">•</span>
    <span>Premium Response Engine</span>
    <span class="text-gray-600">•</span>
    <span class="text-indigo-400 font-semibold">v2.0</span>
  </div>
  <p class="text-gray-500 text-xs mt-4">
    Made with <span class="text-red-500">❤️</span> | LARUK © 2024
  </p>
</div>

<script>
  const form = document.getElementById("chat-form");
  const chatBox = document.getElementById("chat-box");
  const messageInput = document.getElementById("message-input");
  let userLoggedIn = false;

  // Function to escape HTML
  function escapeHtml(text) {
    const map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;'
    };
    return text.replace(/[&<>"']/g, m => map[m]);
  }

  // Auto-scroll to bottom
  function scrollToBottom() {
    chatBox.scrollTop = chatBox.scrollHeight;
  }

  // Show typing indicator
  function showTypingIndicator() {
    const typingDiv = document.createElement("div");
    typingDiv.className = "message msg-ai text-white p-5 rounded-xl max-w-2xl";
    typingDiv.id = "typing-indicator";
    typingDiv.innerHTML = `
      <div class="flex items-start gap-3">
        <div class="flex-shrink-0">
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center text-lg">
            🔥
          </div>
        </div>
        <div class="flex-1">
          <p class="font-semibold text-indigo-300 mb-2">LARUK AI</p>
          <div class="typing">
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
            <div class="typing-dot"></div>
          </div>
        </div>
      </div>
    `;
    chatBox.appendChild(typingDiv);
    scrollToBottom();
  }

  // Remove typing indicator
  function removeTypingIndicator() {
    const typing = document.getElementById("typing-indicator");
    if (typing) typing.remove();
  }

  // Google Login Handler
  function handleGoogleLogin() {
    userLoggedIn = true;
    alert("Google login would integrate with OAuth here! For now, you're in guest mode.");
    messageInput.focus();
  }

  // Guest Login Handler
  function handleGuestLogin() {
    userLoggedIn = true;
    messageInput.focus();
  }

  // Form submission
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!userLoggedIn) {
      alert("Please login first!");
      return;
    }

    const userMessage = messageInput.value.trim();

    if (!userMessage) {
      messageInput.focus();
      return;
    }

    // Add user message
    const userMsgDiv = document.createElement("div");
    userMsgDiv.className = "message msg-user text-white p-5 rounded-xl max-w-2xl ml-auto";
    userMsgDiv.innerHTML = `
      <div class="flex items-start gap-3 justify-end">
        <div class="text-right flex-1">
          <p class="font-semibold text-blue-300 mb-2">You</p>
          <p class="text-gray-100 text-sm">${escapeHtml(userMessage)}</p>
        </div>
        <div class="flex-shrink-0">
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-lg">
            👤
          </div>
        </div>
      </div>
    `;
    chatBox.appendChild(userMsgDiv);

    messageInput.value = "";
    messageInput.style.height = "auto";
    scrollToBottom();

    // Show typing
    showTypingIndicator();

    try {
      const response = await fetch("/chat", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ message: userMessage })
      });

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const data = await response.json();
      const reply = data.reply || "Something went wrong!";

      removeTypingIndicator();

      // Add AI response
      const aiMsgDiv = document.createElement("div");
      aiMsgDiv.className = "message msg-ai text-white p-5 rounded-xl max-w-2xl";
      aiMsgDiv.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center text-lg">
              🔥
            </div>
          </div>
          <div class="flex-1">
            <p class="font-semibold text-indigo-300 mb-2">LARUK AI</p>
            <p class="text-gray-200 text-sm leading-relaxed">${escapeHtml(reply)}</p>
          </div>
        </div>
      `;
      chatBox.appendChild(aiMsgDiv);
      scrollToBottom();

    } catch (error) {
      console.error("Error:", error);
      removeTypingIndicator();

      const errorDiv = document.createElement("div");
      errorDiv.className = "message msg-ai text-white p-5 rounded-xl max-w-2xl";
      errorDiv.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-red-500 to-pink-500 flex items-center justify-center text-lg">
              ⚠️
            </div>
          </div>
          <div class="flex-1">
            <p class="font-semibold text-red-400 mb-2">Error</p>
            <p class="text-gray-300 text-sm">Something went wrong. Please try again!</p>
          </div>
        </div>
      `;
      chatBox.appendChild(errorDiv);
      scrollToBottom();
    }

    messageInput.focus();
  });

  // Textarea auto-expand
  messageInput.addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
  });

  // Keyboard shortcuts
  messageInput.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      form.dispatchEvent(new Event('submit'));
    }
  });

  // Focus on load
  window.addEventListener('load', () => {
    // messageInput.focus();
  });
</script>
{% endblock %}

```
